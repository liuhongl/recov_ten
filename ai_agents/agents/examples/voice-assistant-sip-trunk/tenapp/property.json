                "base_url": "${env:OPENAI_API_BASE|https://api.deepseek.com}",
                "api_key": "${env:OPENAI_API_KEY}",
                "frequency_penalty": 0.2,
                "model": "${env:OPENAI_MODEL|deepseek-chat}",
                "max_tokens": 80,
                "prompt": "你是一个中文电话语音助手。回答要像电话真人对话：直接、短、自然。优先10到20个汉字，最多一句；不要客套寒暄，不重复问候。用户只说一个短词时，只问一句澄清问题。",
                "proxy_url": "${env:OPENAI_PROXY_URL|}",
                "greeting": "",
                "max_memory_length": 10
              }
            },
            {
              "type": "extension",
              "name": "tts",
              "addon": "cosy_tts_python",
              "extension_group": "tts",
