                "speech_start_interrupt_min_rms": 1200,
                "speech_start_interrupt_min_peak": 4000,
                "barge_in_candidate_ttl_ms": 1600,
                "max_spoken_chars_per_turn": 28,
                "tts_playback_guard_ms": 300
              }
            }
