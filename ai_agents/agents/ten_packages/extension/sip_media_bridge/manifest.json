{
  "type": "extension",
  "name": "sip_media_bridge",
  "version": "0.1.0",
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "**.tent",
      "**.py",
      "README.md",
      "tests/**"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "channel": {
          "type": "string"
        },
        "media_hub_base_url": {
          "type": "string"
        },
        "sample_rate": {
          "type": "int32"
        },
        "heartbeat_interval_seconds": {
          "type": "int32"
        },
        "registration_timeout_seconds": {
          "type": "int32"
        }
      }
    }
  }
}
